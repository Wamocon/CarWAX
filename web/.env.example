# Öffentliche Adresse der Seite. Steuert canonical, hreflang, sitemap.xml,
# robots.txt, og:image und die strukturierten Daten. Ohne diesen Wert läuft
# alles gegen den Platzhalter https://carwax-antalya.com — die Seite
# funktioniert, aber Google bekommt die falsche Domain genannt.
# VOR DEM LIVEGANG SETZEN.
NEXT_PUBLIC_SITE_URL=https://ihre-domain.com

# Nach .env.local kopieren und ausfüllen. .env.local ist über .gitignore
# ausgeschlossen und gehört nie ins Repo.
#
# Ohne diese Werte läuft die Seite vollständig — nur der Concierge antwortet
# dann höflich, dass er gerade nicht verfügbar ist, und nennt eine
# Telefonnummer. Kein Fehler, keine leere Blase.

# Selbst gehostetes, OpenAI-kompatibles Backend
AI_API_URL=https://your-endpoint.example.com/api
AI_API_KEY=sk-...
AI_CHAT_COMPLETIONS_PATH=/chat/completions

# Der Concierge beantwortet kurze Auskünfte aus einer festen Wissensbasis.
# Dafür zählt Antwortzeit mehr als Reasoning-Tiefe.
AI_MODEL_CHAT=sokrates-fast

# Verfügbar, aktuell nicht vom Concierge genutzt:
AI_MODEL_FAST=sokrates-fast
AI_MODEL_REASONING=qwen3.6-35b
AI_MODEL_GERMAN_COPY=gemma4-31b
AI_MODEL_PRO=sokrates-pro
